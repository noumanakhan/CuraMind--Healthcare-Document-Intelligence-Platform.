# CuraMind RAG Service Environment Configuration
APP_ENV=development
PORT=8001
DEBUG=True

# --- Google Gemini API Configuration ---
# Place your Gemini API key here:
GEMINI_API_KEY=
# Or alias:
# GOOGLE_API_KEY=your_gemini_api_key_here

# Provider models:
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Database (Pure PostgreSQL + pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=curamind_rag

# --- Security ---
JWT_SECRET=dev-insecure-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
