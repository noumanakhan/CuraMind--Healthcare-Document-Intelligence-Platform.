# ──────────────────────────────────────────────
# CuraMind .gitignore
# ──────────────────────────────────────────────

# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytype/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ── Virtual Environments ────────────────────────
.venv/
venv/
env/
ENV/
.env.local
.env.development
.env.production
.env.test

# ── Secrets / API Keys ──────────────────────────
# Keep .env.example but never commit real .env files
# Uncomment the line below to ignore all .env files
# .env

# ── Databases ───────────────────────────────────
*.sqlite3
*.sqlite
*.db
curamind.db
curamind-*.sqlite3

# ── Node / Frontend ─────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/
.npm

# ── Vite / Frontend Build ────────────────────────
# frontend/dist/ is intentionally committed (serves as static build)
# Remove the next line if you don't want to commit dist/
# frontend/dist/

# ── macOS ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDE / Editor ─────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Logs ─────────────────────────────────────────
*.log
logs/
*.out

# ── Uploaded / Temporary Files ───────────────────
uploads/
tmp/
temp/
*.tmp
*.bak

# ── Alembic ──────────────────────────────────────
# Keep migrations but ignore generated env temp files
backend/alembic/versions/__pycache__/

# ── RAG Service Specific ─────────────────────────
rag-service/.pytest_cache/
rag-service/__pycache__/

# ── Docker ───────────────────────────────────────
.dockerignore
docker-compose.override.yml

# ── Jupyter ──────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── pytest tmp databases ─────────────────────────
/tmp/curamind-*.sqlite3
